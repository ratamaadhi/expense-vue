# API Configuration
# For development with local proxy, use: /api
# For Docker deployment, nginx will proxy /api to the backend
# For direct API access, use full URL: https://expense-api.ratama.space/api
VITE_API_BASE_URL=/api

# Example configurations:
# VITE_API_BASE_URL=/api                          # Use nginx proxy (Docker/Production)
# VITE_API_BASE_URL=https://expense-api.ratama.space/api  # Direct API access
